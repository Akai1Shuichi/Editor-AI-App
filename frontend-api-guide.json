{
  "title": "S Editor - Frontend API Guide",
  "version": "1.0.0",
  "baseUrl": "http://localhost:3000/api/v1",
  "sourceOfTruth": "./openapi.json",
  "usage": {
    "contentType": "application/json",
    "authorization": "Với endpoint requiresAuth=true, gửi header: Authorization: Bearer <accessToken>",
    "responseEnvelope": "Đa số API trả về { success, message, data, requestId }. FE lấy dữ liệu chính tại response.data.",
    "note": "Các giá trị trong dấu <...> là placeholder; thay bằng dữ liệu thực tế."
  },
  "endpoints": [
    {
      "name": "Đăng ký",
      "method": "POST",
      "path": "/auth/signup",
      "requiresAuth": false,
      "body": {
        "email": "user@example.com",
        "password": "password123",
        "confirmPassword": "password123",
        "acceptedTerms": true,
        "name": "Nguyen Van A"
      },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "user": {
            "id": "<uuid>",
            "email": "user@example.com",
            "name": "Nguyen Van A",
            "role": "USER",
            "status": "ACTIVE",
            "provider": "email",
            "avatarUrl": null,
            "tz": "Asia/Bangkok"
          },
          "accessToken": "<jwt-access-token>",
          "refreshToken": "<refresh-token>"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Đăng nhập",
      "method": "POST",
      "path": "/auth/login",
      "requiresAuth": false,
      "body": { "email": "user@example.com", "password": "password123" },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "user": {
            "id": "<uuid>",
            "email": "user@example.com",
            "role": "USER",
            "status": "ACTIVE"
          },
          "accessToken": "<jwt-access-token>",
          "refreshToken": "<refresh-token>"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Đăng nhập Google (Google Identity Services)",
      "method": "POST",
      "path": "/auth/google",
      "requiresAuth": false,
      "body": { "idToken": "<google-id-token>" },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "user": {
            "id": "<uuid>",
            "email": "user@gmail.com",
            "role": "USER",
            "provider": "google"
          },
          "accessToken": "<jwt-access-token>",
          "refreshToken": "<refresh-token>"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Làm mới access token",
      "method": "POST",
      "path": "/auth/refresh",
      "requiresAuth": false,
      "body": { "refreshToken": "<refresh-token>" },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "user": {
            "id": "<uuid>",
            "email": "user@example.com",
            "role": "USER"
          },
          "accessToken": "<new-jwt-access-token>",
          "refreshToken": "<new-refresh-token>"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Đăng xuất",
      "method": "POST",
      "path": "/auth/logout",
      "requiresAuth": false,
      "body": { "refreshToken": "<refresh-token>" },
      "responseExample": {
        "success": true,
        "message": "Logged out successfully",
        "data": { "success": true },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Quên mật khẩu",
      "method": "POST",
      "path": "/auth/forgot-password",
      "requiresAuth": false,
      "body": { "email": "user@example.com" },
      "responseExample": {
        "success": true,
        "message": "If the email exists, a reset link has been sent",
        "data": { "success": true },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Đặt lại mật khẩu",
      "method": "POST",
      "path": "/auth/reset-password",
      "requiresAuth": false,
      "body": {
        "token": "<token-trong-email>",
        "newPassword": "new-password123"
      },
      "responseExample": {
        "success": true,
        "message": "Password reset successfully",
        "data": { "success": true },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Lấy profile hiện tại",
      "method": "GET",
      "path": "/auth/me",
      "requiresAuth": true,
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "id": "<uuid>",
          "email": "user@example.com",
          "name": "Nguyen Van A",
          "avatarUrl": null,
          "provider": "email",
          "tz": "Asia/Bangkok",
          "role": "USER",
          "status": "ACTIVE",
          "createdAt": "2026-09-20T00:00:00.000Z",
          "updatedAt": "2026-09-20T00:00:00.000Z"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Cập nhật cài đặt profile",
      "method": "PATCH",
      "path": "/auth/me/settings",
      "requiresAuth": true,
      "body": {
        "name": "Nguyen Van B",
        "avatarUrl": "https://example.com/avatar.png",
        "tz": "Asia/Ho_Chi_Minh"
      },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "id": "<uuid>",
          "email": "user@example.com",
          "name": "Nguyen Van B",
          "avatarUrl": "https://example.com/avatar.png",
          "tz": "Asia/Ho_Chi_Minh",
          "role": "USER"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Ghi nhận watermark",
      "method": "POST",
      "path": "/watermarks",
      "requiresAuth": false,
      "body": {
        "device_id": "<sha-256-cua-device-id>",
        "type": "WATERMARK_GGFLOW",
        "version": "1.0.0"
      },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "id": "<uuid>",
          "deviceId": "<sha-256-cua-device-id>",
          "type": "WATERMARK_GGFLOW",
          "version": "1.0.0",
          "createdAt": "2026-09-20T00:00:00.000Z"
        },
        "requestId": "<request-id>"
      },
      "note": "Có thể gửi deviceId thay cho device_id."
    },
    {
      "name": "Kiểm tra thiết bị đã cài app",
      "method": "GET",
      "path": "/installations/check/<deviceId>?version=1.0.0",
      "requiresAuth": false,
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "installed": true,
          "version": "1.0.0",
          "installedAt": "2026-09-18T20:10:00.000Z",
          "targetVersion": "1.0.0",
          "isMatchedVersion": true,
          "latestVersion": "1.1.0",
          "hasUpdate": true
        },
        "requestId": "<request-id>"
      },
      "note": "Query version là tùy chọn. Nếu không truyền, targetVersion và isMatchedVersion sẽ là null."
    },
    {
      "name": "Ghi nhận cài đặt app",
      "method": "POST",
      "path": "/installations",
      "requiresAuth": false,
      "body": { "version": "1.0.0", "device_id": "<sha-256-cua-device-id>" },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "id": "<uuid>",
          "deviceId": "<sha-256-cua-device-id>",
          "version": "1.0.0",
          "ip": "127.0.0.1",
          "createdAt": "2026-09-20T00:00:00.000Z"
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Kiểm tra phiên bản mới",
      "method": "POST",
      "path": "/update/check",
      "requiresAuth": false,
      "body": { "code": "s-editor", "currentVersion": "1.0.0" },
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "hasNewVersion": true,
          "latestVersion": "2.0.0",
          "changeLog": "<ul><li>New feature</li></ul>",
          "downloadLink": [
            "https://cdn.example.com/s-editor-2.0.0-linux.zip",
            "https://cdn.example.com/s-editor-2.0.0-macos.dmg",
            "https://cdn.example.com/s-editor-2.0.0-windows.exe"
          ],
          "message": "New version available!"
        },
        "requestId": "<request-id>"
      },
      "note": "downloadLink là mảng link theo OS, hoặc null khi không có bản cập nhật."
    },
    {
      "name": "Danh sách phần mềm đang active",
      "method": "GET",
      "path": "/update/software",
      "requiresAuth": false,
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": [
          {
            "id": 1,
            "code": "s-editor",
            "name": "S Editor",
            "latestVersionName": "1.0.0",
            "latestVersionDate": "2025-11-25T10:00:00.000Z",
            "downloadLink": [
              "https://cdn.example.com/s-editor-linux.zip",
              "https://cdn.example.com/s-editor-macos.dmg",
              "https://cdn.example.com/s-editor-windows.exe"
            ],
            "downloadCount": 42,
            "status": 1
          }
        ],
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Danh sách phiên bản theo mã phần mềm",
      "method": "GET",
      "path": "/update/versions?code=s-editor",
      "requiresAuth": false,
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": [
          {
            "id": 1,
            "name": "1.0.0",
            "createDate": "2025-11-25T10:00:00.000Z",
            "downloadLink": [
              "https://cdn.example.com/s-editor-linux.zip",
              "https://cdn.example.com/s-editor-macos.dmg",
              "https://cdn.example.com/s-editor-windows.exe"
            ],
            "changeLog": "<ul><li>Fix bug</li></ul>",
            "status": 1,
            "downloadCount": 42
          }
        ],
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Chi tiết phần mềm theo code",
      "method": "GET",
      "path": "/update/software/code/s-editor",
      "requiresAuth": false,
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "id": 1,
          "code": "s-editor",
          "name": "S Editor",
          "latestVersionName": "1.0.0",
          "downloadLink": [
            "https://cdn.example.com/s-editor-linux.zip",
            "https://cdn.example.com/s-editor-macos.dmg",
            "https://cdn.example.com/s-editor-windows.exe"
          ],
          "changeLog": "<ul><li>Fix bug</li></ul>",
          "downloadCount": 42
        },
        "requestId": "<request-id>"
      }
    },
    {
      "name": "Tải bản cài đặt",
      "method": "GET",
      "path": "/update/download?code=s-editor&versionName=1.0.0&os=windows",
      "requiresAuth": false,
      "responseExample": {
        "status": 302,
        "note": "Backend redirect đến link tương ứng OS. os nhận windows | macos | linux; bỏ os thì backend tự nhận diện User-Agent, không nhận diện được sẽ chọn link đầu tiên."
      },
      "note": "Nên dùng window.location.href = url download thay vì fetch/axios để browser theo redirect và tải file."
    },
    {
      "name": "[Admin] Tổng quan analytics theo version",
      "method": "GET",
      "path": "/analytics/overview?version=1.0.0",
      "requiresAuth": true,
      "requiresRole": "ADMIN",
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "totalInstallations": 1250,
          "installationsToday": 45,
          "installationsThisWeek": 210,
          "installationsThisMonth": 680,
          "totalWatermarks": 8400,
          "watermarksToday": 320,
          "filterVersion": "1.0.0",
          "installationsByVersion": [{ "version": "1.0.0", "count": 900 }],
          "watermarksByVersion": [{ "version": "1.0.0", "count": 6400 }]
        },
        "requestId": "<request-id>"
      },
      "note": "Query version là tùy chọn; bỏ query để lấy tổng quan tất cả phiên bản."
    },
    {
      "name": "[Admin] Analytics watermark theo ngày/version",
      "method": "GET",
      "path": "/analytics/watermarks?startDate=2026-09-01&endDate=2026-09-30&type=WATERMARK_GGFLOW&version=1.0.0",
      "requiresAuth": true,
      "requiresRole": "ADMIN",
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "totalCount": 156,
          "stats": [{ "date": "2026-09-18", "count": 28 }],
          "byVersion": [{ "version": "1.0.0", "count": 120 }]
        },
        "requestId": "<request-id>"
      },
      "note": "Tất cả query đều tùy chọn: startDate, endDate (YYYY-MM-DD), type, version."
    },
    {
      "name": "[Admin] Analytics installation theo kỳ/version",
      "method": "GET",
      "path": "/analytics/installations?period=daily&startDate=2026-09-01&endDate=2026-09-30&version=1.0.0",
      "requiresAuth": true,
      "requiresRole": "ADMIN",
      "responseExample": {
        "success": true,
        "message": "Success",
        "data": {
          "totalInstallations": 1250,
          "period": "daily",
          "stats": [{ "date": "2026-09-18", "count": 45 }]
        },
        "requestId": "<request-id>"
      },
      "note": "period nhận daily | weekly | monthly; mặc định daily. startDate, endDate, version đều tùy chọn."
    }
  ],
  "commonErrorResponse": {
    "success": false,
    "message": "Validation failed",
    "data": null,
    "requestId": "<request-id>"
  }
}
